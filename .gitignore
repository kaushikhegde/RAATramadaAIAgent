# ─── Dependencies ───────────────────────────────────────────
node_modules/

# ─── Secrets & environment ──────────────────────────────────
.env
.env.*
!.env.example

# ─── Chrome CDP profile (cookies / session data) ────────────
.jetstar-profile-cdp/

# ─── Runtime artifacts (may contain booking PII) ────────────
Completed/*
!Completed/.gitkeep
Todo/*
!Todo/.gitkeep

# ─── OS / editor ────────────────────────────────────────────
.DS_Store
**/.DS_Store
.idea/

# ─── Runtime data files (payment audit logs, mock DBs) ──────
# Generated by mint-client.js / iccp-client.js / payments-store.js / the mock
# servers. Never committed — even redacted, an audit log carries booking and
# supplier detail, and a mock DB carries fake-but-realistic card data.
payments-store.json
mint-api-log.jsonl
mock-mint-db.json
iccp-api-log.jsonl
mock-iccp-db.json
demo-payments-store.json
