# Gemini API Key (get free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Server port (chatbot runs here)
PORT=3000

# ─── OpenClaw Gateway ─────────────────────────────────────────
# The Gateway URL — matches your docker-compose port mapping
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Gateway auth token (from your openclaw.json auth.token field)
OPENCLAW_GATEWAY_TOKEN=

# Debug mode (verbose logging — set to true when troubleshooting)
DEBUG=false
