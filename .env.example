# Gemini API Key (get free from https://aistudio.google.com/apikey) — REQUIRED
GEMINI_API_KEY=your-gemini-api-key-here

# Server port (chatbot UI + WebSocket)
PORT=3000

# Chrome remote-debugging port. start-chrome.sh launches Chrome on this port,
# and booking.js connects to it via Playwright CDP.
CDP_PORT=9222

# Debug mode (verbose logging — set to true when troubleshooting)
DEBUG=false

# ─── Optional: booking.js standalone runs (npm run book:*) ────
# Use Playwright's bundled Chromium instead of connecting to your real Chrome
# USE_PLAYWRIGHT=false
# Launch the system Chrome channel directly (e.g. "chrome")
# BROWSER_CHANNEL=
# Run the browser headless
# HEADLESS=false

# ─── Mastercard ICCP (Westpac DVC via API) — see iccp-client.js ────
# mock (default, local mock-iccp-server.js: node mock-iccp-server.js) | sandbox | production
# ICCP_ENVIRONMENT=mock
# ICCP_CONSUMER_KEY=
# Path to the .p12 signing key file — keep it OUTSIDE this repo.
# ICCP_P12_PATH=
# ICCP_P12_PASSWORD=
# Only needed if the .p12 holds more than one key.
# ICCP_P12_ALIAS=
# RAA's own ICCP account config (Mastercard-admin-provisioned, not self-service —
# look up via iccpClient.getCompanies/getRealCards/getCompanyPurchaseTemplates)
# ICCP_COMPANY_ID=
# ICCP_DATA_SOURCE_ID=
# ICCP_RCN_ID=
# ICCP_RCN_ALIAS=
# ICCP_TEMPLATE_ID=
# ICCP_PURCHASE_TYPE=All MCCs
# ICCP_DEFAULT_TIMEZONE=Australia/Brisbane

# ─── MintEFT (supplier payments via API) — see mint-client.js ────
# mock (default, local mock-mint-server.js: node mock-mint-server.js) | uat | production
# MINT_BASE_URL=http://localhost:4000/eft/v1
# MINT_API_KEY=
# RAA's own Mint account/company number (the payer) — Mint-admin-provisioned,
# not booking data. Not the same as a payee's mint_company_number.
# MINT_PAYER_COMPANY_NUMBER=
# Optional — falls back to the consultant's own email if omitted.
# MINT_DEFAULT_USER_EMAIL=
# Optional — a server-to-server call has no real browser IP to report.
# MINT_USER_IP=127.0.0.1
# MINT_DEFAULT_TIMEZONE=Australia/Brisbane
# How often to poll real Mint for authorisation status (ms) — irrelevant in mock mode (SSE).
# MINT_POLL_INTERVAL_MS=20000

# ⚠️ TEMPORARY DEMO OVERRIDE — see mint-payment-issuer.js's resolvePayee().
# Forces EVERY booking's Mint payee to one hardcoded company number, regardless
# of the booking's real supplier — only meant to unblock end-to-end testing
# before real suppliers are onboarded as Mint payees. Leave unset otherwise.
# MINT_FORCE_PAYEE_COMPANY_NUMBER=
# MINT_FORCE_PAYEE_NAME=
